LOCALSTACK_AUTH_TOKEN=
LOCALSTACK_DEBUG=0

GATEWAY_IMAGE=fsamp-gateway:local
PROCESSOR_IMAGE=fsamp-processor:local

# Generated by `cd ../fsamp-infra && make local-parity`.
# Keep localhost:8080 only when running `make demo-fast`.
GATEWAY_URL=http://localhost:8080
GATEWAY_UPLOAD_PATH=/files/upload
GATEWAY_HEALTH_PATH=/health
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

S3_BUCKET_NAME=fsamp-local-files
DYNAMODB_TABLE_NAME=fsamp-local-file-metadata
OUTBOX_TABLE_NAME=fsamp-local-outbox
DYNAMODB_IDEMPOTENCY_TABLE_NAME=fsamp-local-idempotency-keys
FSAMP_DEMO_RUNTIME=terraform-local
DIRECT_PUBLISH_AFTER_OUTBOX=false
SQS_QUEUE_NAME=fsamp-local-file-processing
SQS_QUEUE_URL=http://localhost:4566/000000000000/fsamp-local-file-processing
SQS_PROCESSING_DLQ_NAME=fsamp-local-processing-dlq
SQS_PROCESSING_DLQ_URL=http://localhost:4566/000000000000/fsamp-local-processing-dlq
SNS_TOPIC_ARN=arn:aws:sns:us-west-2:000000000000:fsamp-local-file-events
FILE_EVENTS_TOPIC_ARN=arn:aws:sns:us-west-2:000000000000:fsamp-local-file-events
PROCESSING_EVENTS_TOPIC_ARN=arn:aws:sns:us-west-2:000000000000:fsamp-local-processing-events
KMS_KEY_ID=alias/fsamp-local-master-key

PROCESSOR_LAMBDA_NAME=fsamp-local-processor
OUTBOX_PUBLISHER_LAMBDA_NAME=fsamp-local-outbox-publisher

TEST_USER=e2e-test-user
TEST_PASSWORD=E2eTestPass123!

FSAMP_DEMO_DOCKER_LOGS=false
